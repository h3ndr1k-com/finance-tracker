{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "Ledger",
    "version": "3.0.0",
    "baselineGrid": "4px"
  },
  "color": {
    "light": {
      "background": { "$value": "#F4F4F2", "$type": "color" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceRaised": { "$value": "#ECECEA", "$type": "color" },
      "text": { "$value": "#111111", "$type": "color" },
      "textMuted": { "$value": "#6B6B6B", "$type": "color" },
      "border": { "$value": "#E0E0DE", "$type": "color" },
      "brand": { "$value": "#C8FF00", "$type": "color" },
      "brandHover": { "$value": "#B6E600", "$type": "color" },
      "brandSoft": { "$value": "#F0FFB0", "$type": "color" },
      "onBrand": { "$value": "#111111", "$type": "color" },
      "positive": { "$value": "#2D9B6A", "$type": "color" },
      "positiveSoft": { "$value": "#DFF3E9", "$type": "color" },
      "negative": { "$value": "#E5484D", "$type": "color" },
      "negativeSoft": { "$value": "#FBE0E1", "$type": "color" },
      "warning": { "$value": "#A46E19", "$type": "color" },
      "warningSoft": { "$value": "#F5E7C7", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#0E0E0E", "$type": "color" },
      "surface": { "$value": "#1A1A1A", "$type": "color" },
      "surfaceRaised": { "$value": "#242424", "$type": "color" },
      "text": { "$value": "#F5F5F5", "$type": "color" },
      "textMuted": { "$value": "#9A9A9A", "$type": "color" },
      "border": { "$value": "#333333", "$type": "color" },
      "brand": { "$value": "#C8FF00", "$type": "color" },
      "brandHover": { "$value": "#D6FF33", "$type": "color" },
      "brandSoft": { "$value": "#2A3300", "$type": "color" },
      "onBrand": { "$value": "#111111", "$type": "color" },
      "positive": { "$value": "#5FE0A8", "$type": "color" },
      "positiveSoft": { "$value": "#0F2A1E", "$type": "color" },
      "negative": { "$value": "#FF6B6B", "$type": "color" },
      "negativeSoft": { "$value": "#2E1414", "$type": "color" },
      "warning": { "$value": "#E2B65F", "$type": "color" },
      "warningSoft": { "$value": "#3C3320", "$type": "color" }
    }
  },
  "typography": {
    "displayFamily": { "$value": "Instrument Sans, system-ui, sans-serif", "$type": "fontFamily" },
    "bodyFamily": { "$value": "Instrument Sans, system-ui, sans-serif", "$type": "fontFamily" },
    "numericFamily": { "$value": "IBM Plex Mono, ui-monospace, monospace", "$type": "fontFamily" },
    "baseSize": { "$value": "15px", "$type": "dimension" },
    "bodyLineHeight": { "$value": 1.5, "$type": "number" },
    "displayTracking": { "$value": "-0.03em", "$type": "dimension" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "control": { "$value": "12px", "$type": "dimension" },
    "surface": { "$value": "22px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" },
    "dialog": { "$value": "26px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "160ms", "$type": "duration" },
    "standard": { "$value": "220ms", "$type": "duration" },
    "slow": { "$value": "300ms", "$type": "duration" },
    "easeOut": { "$value": [0.22, 1, 0.36, 1], "$type": "cubicBezier" }
  },
  "layout": {
    "contentMax": { "$value": "1240px", "$type": "dimension" },
    "mobile": { "$value": "320px", "$type": "dimension" },
    "tablet": { "$value": "760px", "$type": "dimension" },
    "desktop": { "$value": "1100px", "$type": "dimension" }
  }
}
